# Health Track backend: everything deploys to us-east-1 (N. Virginia), the only supported region.
# Credentials come from `aws configure` / SSO; never put keys in this file.
AWS_DEFAULT_REGION=us-east-1
CDK_ENV=dev

# Runtime secrets are NOT environment variables. They live in SSM Parameter Store
# (SecureString, encrypted with the health-data KMS key) and are created by:
#   python scripts/bootstrap_params.py --env dev
#     /health-track/<env>/fapshi/credentials      "apiuser:apikey" or UNSET (payments simulated outside prod)
#     /health-track/<env>/push/vapid-public-key   generated
#     /health-track/<env>/push/vapid-private-key  generated
#     /health-track/<env>/channels/gateway-token  generated; telco gateway sends it as X-Gateway-Token
