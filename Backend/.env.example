# AWS environment target (dev | staging | prod)
CDK_ENV=dev

# AWS credentials (set via aws configure or environment)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=af-south-1

# Fapshi — populated by SecretsStack (do NOT commit real values)
# Secret ARN: /health-track/{env}/fapshi/api-key
FAPSHI_API_KEY=

# Fapshi webhook signing secret
# Secret ARN: /health-track/{env}/fapshi/webhook-secret
FAPSHI_WEBHOOK_SECRET=

# VAPID private key for web push
# Secret ARN: /health-track/{env}/push/vapid-private-key
VAPID_PRIVATE_KEY=

# Telco sandbox credentials (JSON)
# Secret ARN: /health-track/{env}/telco/sandbox-credentials
TELCO_SANDBOX_CREDENTIALS=
