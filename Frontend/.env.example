# Leave all API URLs empty to run with the built-in mock API (no backend needed).
# One base URL covers every service; set a per-service URL when a stack has its own API Gateway.
VITE_API_BASE_URL=
VITE_API_URL_PROFILE=
VITE_API_URL_FACILITY=
VITE_API_URL_TRIAGE=
VITE_API_URL_CONSULTATION=
VITE_API_URL_PAYMENT=
VITE_API_URL_DOCTOR=
VITE_API_URL_PUSH=
VITE_API_URL_EXTENDED=
VITE_API_URL_CHANNEL=
VITE_API_URL_ANONYMOUS=
VITE_API_URL_DOCTOR_APPLICATION=

# Cognito Hosted UI (OIDC + PKCE). Leave empty to use demo sign-in.
# Authority is the user pool issuer: https://cognito-idp.<region>.amazonaws.com/<user_pool_id>
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback

VITE_CONSULTATION_FEE_XAF=2000
VITE_OSM_TILE_URL=

# Feature flags (true/false). See src/config/flags.ts for the full list and defaults.
# VITE_FLAG_MAP_VIEW=false

# Separate staff pool (mandatory authenticator MFA; no self sign-up).
VITE_COGNITO_STAFF_AUTHORITY=
VITE_COGNITO_STAFF_DOMAIN=
VITE_COGNITO_STAFF_CLIENT_ID=
VITE_COGNITO_STAFF_REDIRECT_URI=http://localhost:5173/auth/callback

VITE_API_URL_I18N=

# Optional, referrer-restricted key for the free Maps Embed API. No Maps JavaScript/Places API used.
VITE_GOOGLE_MAPS_EMBED_API_KEY=
