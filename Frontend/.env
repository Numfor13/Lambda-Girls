# Placeholders only. Put real values in Frontend/.env.local (gitignored).
# Backend: one API Gateway for every service (HealthTrack-Api-<env> output ApiUrl).
# Leave VITE_API_BASE_URL empty to use the built-in mock API.
VITE_API_BASE_URL=

# Cognito (HealthTrack-Auth-<env> outputs)
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=

# Must match the backend's consultationFeeXaf (default 2000).
VITE_CONSULTATION_FEE_XAF=2000
VITE_OSM_TILE_URL=
